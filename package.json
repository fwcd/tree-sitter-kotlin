{
  "name": "tree-sitter-kotlin",
  "version": "0.4.0",
  "description": "Tree-sitter grammar for Kotlin",
  "main": "bindings/node",
  "types": "bindings/node",
  "scripts": {
    "test": "tree-sitter test",
    "install": "node bindings/node/build.js",
    "generate": "node bindings/node/build.js --generate",
    "parse": "tree-sitter parse",
    "build-wasm": "tree-sitter build --wasm",
    "playground": "tree-sitter playground",
    "prestart": "npm run build-wasm",
    "start": "npm run playground",
    "prebuildify": "prebuildify --napi --strip",
    "vendor-fixtures": "node tools/vendor-fixtures.js",
    "vendor-jetbrains": "node tools/vendor-jetbrains-tests.js",
    "psi-oracle:fetch": "node tools/psi-oracle/fetch.js",
    "psi-oracle:verify": "node tools/vendor-fixtures.js --oracle-corpus local/psi-gate/corpora/testdata && node tools/psi-oracle/verify.js",
    "psi-gate": "node tools/psi-gate/main.js",
    "psi-fuzz": "node tools/psi-gate/main.js fuzz",
    "test:tools": "npx vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fwcd/tree-sitter-kotlin.git"
  },
  "keywords": [
    "tree-sitter",
    "kotlin",
    "grammar"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**"
  ],
  "author": "fwcd",
  "license": "MIT",
  "gypfile": true,
  "bugs": {
    "url": "https://github.com/fwcd/tree-sitter-kotlin/issues"
  },
  "homepage": "https://github.com/fwcd/tree-sitter-kotlin#readme",
  "dependencies": {
    "node-addon-api": "^8.2.2",
    "node-gyp-build": "^4.8.2"
  },
  "peerDependencies": {
    "tree-sitter": "^0.21.1"
  },
  "peerDependenciesMeta": {
    "tree_sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "minimatch": "11.0.4",
    "prebuildify": "^6.0.0",
    "smol-toml": "1.9.1",
    "tree-sitter-cli": "0.24.7",
    "undici": "6.29.1",
    "vitest": "^4.1.0"
  },
  "tree-sitter": [
    {
      "scope": "source.kotlin",
      "injection-regex": "^kotlin$"
    }
  ],
  "allowScripts": {
    "tree-sitter": true,
    "tree-sitter-cli": true
  }
}
